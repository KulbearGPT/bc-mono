NODE_ENV=development
API_PORT=3000
API_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://blackcat_app:blackcat_app@localhost:5432/blackcat
MIGRATION_DATABASE_URL=postgresql://blackcat:blackcat@localhost:5432/blackcat
BOT_SERVICE_TOKEN=change-me-dev-service-token
# Dedicated HMAC secret for compact pagination cursors (minimum 32 characters in production).
PAGINATION_CURSOR_SIGNING_SECRET=change-me-pagination-cursor-signing-secret
GIFT_CONTINUATION_SIGNING_SECRET=change-me-gift-continuation-signing-secret
# Railway pilot defaults to the persistent Sandbox adapter; switch explicitly to HTTP_PROVIDER for a real Provider.
BUSINESS_ENV=SANDBOX
FUNDING_ADAPTER=SANDBOX
SANDBOX_BINDING_CODE_SECRET=change-me-sandbox-binding-code-secret
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_BASE_URL=
PAYMENT_PROVIDER_SERVICE_TOKEN=
PAYMENT_PROVIDER_WEBHOOK_SECRET=
# Independent HMAC secret for short-lived /bot-config preview tokens (minimum 32 characters).
BOT_CONFIG_VALIDATION_SECRET=change-me-bot-config-validation-secret
DISPATCH_CHANNEL_ID=000000000000000000
GIFT_BROADCAST_CHANNEL_ID=000000000000000000
RECHARGE_URL=https://payments.example.invalid/recharge
# DISCORD_BOT_TOKEN is intentionally optional for local prototype work until credentials are provided.
DISCORD_BOT_TOKEN=
# Dashboard Discord OAuth2 and server-side session settings.
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/discord/callback
DISCORD_GUILD_ID=000000000000000000
# Set only for the first successful deployment, then remove it before restarting.
BOOTSTRAP_L4_DISCORD_USER_ID=
DISCORD_ROLE_MAPPING_VERSION=1
DASHBOARD_URL=http://localhost:5173
DASHBOARD_CSRF_SECRET=change-me-dashboard-csrf-secret
DASHBOARD_MFA_ENCRYPTION_KEY=change-me-dashboard-mfa-encryption-key
