model OutboxEvent {
  id                String       @id @default(uuid()) @db.Uuid
  eventType         String       @map("event_type") @db.VarChar(100)
  aggregateType     String       @map("aggregate_type") @db.VarChar(80)
  aggregateId       String       @map("aggregate_id") @db.Uuid
  orderId           String?      @map("order_id") @db.Uuid
  giftRequestId     String?      @map("gift_request_id") @db.Uuid
  selectionPoolId   String?      @map("selection_pool_id") @db.Uuid
  dedupeKey         String       @unique @map("dedupe_key") @db.VarChar(200)
  payload           Json         @db.JsonB
  status            OutboxStatus @default(PENDING)
  rowVersion        Int          @default(1) @map("row_version")
  attemptCount      Int          @default(0) @map("attempt_count")
  maxAttempts       Int          @default(8) @map("max_attempts")
  availableAt       DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  lockedAt          DateTime?    @map("locked_at") @db.Timestamptz(3)
  lockedBy          String?      @map("locked_by") @db.VarChar(100)
  completedAt       DateTime?    @map("completed_at") @db.Timestamptz(3)
  lastError         String?      @map("last_error") @db.VarChar(2000)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  order           Order?           @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  giftRequest     GiftRequest?     @relation(fields: [giftRequestId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  selectionPool   SelectionPool?   @relation(fields: [selectionPoolId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@map("outbox_events")
}

model RiskEvent {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  orderId          String?       @map("order_id") @db.Uuid
  type             RiskEventType
  severity         RiskSeverity
  source           String        @db.VarChar(80)
  notes            String        @db.VarChar(1000)
  createdByStaffId String?       @map("created_by_staff_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  order     Order?        @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy StaffAccount? @relation("RiskCreatedBy", fields: [createdByStaffId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId, createdAt])
  @@index([type, severity, createdAt])
  @@map("risk_events")
}

model AuditLog {
  id                String       @id @default(uuid()) @db.Uuid
  actorUserId       String?      @map("actor_user_id") @db.Uuid
  actorStaffId      String?      @map("actor_staff_id") @db.Uuid
  actorLevel        StaffLevel?  @map("actor_level")
  actorSource       ActorSource  @map("actor_source")
  clientId          String       @map("client_id") @db.VarChar(80)
  interactionId     String?      @map("interaction_id") @db.VarChar(32)
  permissionCode    String?      @map("permission_code") @db.VarChar(100)
  action            String       @db.VarChar(120)
  targetType        String       @map("target_type") @db.VarChar(80)
  targetId          String       @map("target_id") @db.VarChar(80)
  outcome           AuditOutcome
  beforeSnapshot    Json?        @map("before_snapshot") @db.JsonB
  afterSnapshot     Json?        @map("after_snapshot") @db.JsonB
  reason            String?      @db.VarChar(1000)
  requestId         String       @map("request_id") @db.VarChar(128)
  idempotencyKey    String?      @map("idempotency_key") @db.VarChar(200)
  approvalRequestId String?      @map("approval_request_id") @db.Uuid
  jobId             String?      @map("job_id") @db.Uuid
  triggerSource     String?      @map("trigger_source") @db.VarChar(100)
  retryAttempt      Int?         @map("retry_attempt")
  ipHash            String?      @map("ip_hash") @db.VarChar(128)
  userAgentHash     String?      @map("user_agent_hash") @db.VarChar(128)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  actorUser       User?            @relation("AuditActorUser", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  actorStaff      StaffAccount?    @relation("AuditActorStaff", fields: [actorStaffId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  approvalRequest ApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  changes         AuditLogChange[]

  @@index([targetType, targetId, createdAt])
  @@index([actorStaffId, createdAt])
  @@index([requestId])
  @@index([interactionId])
  @@index([outcome, createdAt])
  @@map("audit_logs")
}

model AuditLogChange {
  id             String          @id @default(uuid()) @db.Uuid
  auditLogId     String          @map("audit_log_id") @db.Uuid
  sequence       Int
  targetType     String          @map("target_type") @db.VarChar(80)
  targetId       String          @map("target_id") @db.VarChar(100)
  changeType     AuditChangeType @map("change_type")
  beforeSnapshot Json?           @map("before_snapshot") @db.JsonB
  afterSnapshot  Json?           @map("after_snapshot") @db.JsonB
  changedFields  Json            @map("changed_fields") @db.JsonB
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  auditLog AuditLog @relation(fields: [auditLogId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([auditLogId, sequence])
  @@index([targetType, targetId, createdAt])
  @@map("audit_log_changes")
}
