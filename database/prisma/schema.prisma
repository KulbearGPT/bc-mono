  versions ServicePackageVersion[]

  @@index([gameCode, archivedAt])
  @@map("service_packages")
}

/// An immutable, publishable package template. Applying it expands slots into OrderRequirement rows.
model ServicePackageVersion {
  id                        String               @id @default(uuid()) @db.Uuid
  servicePackageId          String               @map("service_package_id") @db.Uuid
  version                   Int
  status                    CatalogVersionStatus @default(DRAFT)
  activePackageKey          String?              @unique @map("active_package_key") @db.Uuid
  displayName               String               @map("display_name") @db.VarChar(100)
  description               String               @db.VarChar(1000)
  /// Server-derived immutable sum of slot catalog unit prices multiplied by slot unit counts.
  defaultCustomerPriceMinor BigInt               @map("default_customer_price_minor")
  currency                  String               @db.Char(3)
  createdByStaffId          String               @map("created_by_staff_id") @db.Uuid
  activatedAt               DateTime?            @map("activated_at") @db.Timestamptz(3)
  retiredAt                 DateTime?             @map("retired_at") @db.Timestamptz(3)
  createdAt                 DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  servicePackage ServicePackage       @relation(fields: [servicePackageId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  slots          ServicePackageSlot[]
  sourceOrders   Order[]

  @@unique([servicePackageId, version])
  @@index([status, servicePackageId])
  @@index([createdAt, id], map: "service_package_versions_created_at_id_idx")
  @@index([displayName, id], map: "service_package_versions_name_id_idx")
  @@index([defaultCustomerPriceMinor, id], map: "service_package_versions_price_id_idx")
  @@index([version, id], map: "service_package_versions_version_id_idx")
  @@map("service_package_versions")
}

