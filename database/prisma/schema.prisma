/// Original reservation amount and current lifecycle only; remaining reserved value is derived from events.
model FundReservation {
  id              String                    @id @default(uuid()) @db.Uuid
  userId          String                    @map("user_id") @db.Uuid
  sourceType      FundReservationSourceType @map("source_type")
  orderId         String?                   @unique @map("order_id") @db.Uuid
  giftRequestId   String?                   @unique @map("gift_request_id") @db.Uuid
  mode            FundReservationMode
  provider        String?                   @db.VarChar(50)
  providerHoldRef String?                   @map("provider_hold_ref") @db.VarChar(255)
  amountMinor     BigInt                    @map("amount_minor")
  currency        String                    @db.Char(3)
  status          FundReservationStatus     @default(PENDING)
  rowVersion      Int                       @default(1) @map("row_version")
  idempotencyKey  String                    @unique @map("idempotency_key") @db.VarChar(200)
  expiresAt       DateTime?                 @map("expires_at") @db.Timestamptz(3)
  activatedAt     DateTime?                 @map("activated_at") @db.Timestamptz(3)
  settledAt       DateTime?                 @map("settled_at") @db.Timestamptz(3)
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                 User                       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  order                Order?                     @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  giftRequest          GiftRequest?               @relation(fields: [giftRequestId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  events               FundReservationEvent[]
  externalTransaction  ExternalTransaction?
  cancellationPreviews CancellationPreview[]

  @@unique([provider, providerHoldRef])
  @@index([userId, currency, status])
  @@index([status, expiresAt])
  @@map("fund_reservations")
}

/// Append-only reservation lifecycle and amount deltas.
model FundReservationEvent {
  id                String                   @id @default(uuid()) @db.Uuid
  fundReservationId String                   @map("fund_reservation_id") @db.Uuid
  sequence          Int
  eventType         FundReservationEventType @map("event_type")
  fromStatus        FundReservationStatus?   @map("from_status")
  toStatus          FundReservationStatus    @map("to_status")
  amountMinor       BigInt                   @default(0) @map("amount_minor")
  reservationVersion Int                    @map("reservation_version")
  idempotencyKey    String                   @unique @map("idempotency_key") @db.VarChar(200)
  actorUserId       String?                  @map("actor_user_id") @db.Uuid
  actorStaffId      String?                  @map("actor_staff_id") @db.Uuid
  actorSource       ActorSource              @map("actor_source")
  reasonCode        String?                  @map("reason_code") @db.VarChar(100)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  fundReservation FundReservation @relation(fields: [fundReservationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actorUser        User?           @relation("FundReservationEventActorUser", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  actorStaff       StaffAccount?   @relation("FundReservationEventActorStaff", fields: [actorStaffId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([fundReservationId, sequence])
  @@index([fundReservationId, createdAt])
  @@map("fund_reservation_events")
}

