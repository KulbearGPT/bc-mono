{
  "name": "blackcat-companion-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "modules/*",
    "database"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "build:railway": "npm run build && npm run build -w @blackcat/dashboard",
    "db:migrate:deploy": "dotenv -e .env -- sh -c 'DATABASE_URL=${MIGRATION_DATABASE_URL:-$DATABASE_URL} prisma migrate deploy --schema database/prisma/schema.prisma'",
    "db:validate": "dotenv -e .env.example -- prisma validate --schema database/prisma/schema.prisma",
    "db:verify:migration": "bash scripts/verify-m0-us-02-migration.sh",
    "dev": "dotenv -e .env -e .env.example -- concurrently -n api,worker,bot,dashboard -c blue,yellow,magenta,green \"npm run dev -w @blackcat/api\" \"npm run worker -w @blackcat/api\" \"npm run dev -w @blackcat/bot\" \"npm run dev -w @blackcat/dashboard\"",
    "m0:verify": "vitest run tests/m0-us-01.spec.ts tests/m0-us-02.spec.ts tests/m0-us-03.spec.ts tests/m0-us-04.spec.ts tests/m0-us-05.spec.ts",
    "e2e:db:prepare": "bash scripts/e2e/prepare-dashboard-e2e-db.sh",
    "e2e:coverage:verify": "node scripts/e2e/verify-dashboard-e2e-coverage.mjs",
    "test:e2e:dashboard:isolated": "bash scripts/e2e/run-dashboard-e2e-isolated.sh",
    "test:e2e:dashboard:stability": "bash scripts/e2e/verify-dashboard-e2e-stability.sh",
    "test:e2e:dashboard": "playwright test --project=chromium",
    "test:e2e:dashboard:headed": "E2E_SLOW_MO=500 playwright test --project=chromium --headed --workers=1",
    "test:e2e:dashboard:debug": "PWDEBUG=1 playwright test --project=chromium --workers=1",
    "test:e2e:dashboard:compat": "playwright test tests/e2e/dashboard/dashboard-cross-browser.spec.ts --project=chromium --project=firefox --project=webkit",
    "start:web": "node apps/api/dist/index.js",
    "start:bot": "node apps/bot/dist/index.js",
    "start:worker": "node apps/api/dist/worker.js",
    "test": "npm run build && vitest run",
    "typecheck": "tsc -b tsconfig.build.json",
    "quality:routes": "node scripts/check-api-route-contracts.mjs",
    "lint:api": "eslint apps/api/src --max-warnings 0",
    "lint:api-dashboard": "eslint apps/api/src apps/dashboard/src --max-warnings 0",
    "format:check": "prettier --check modules/platform/src/api-contracts.ts scripts/check-api-route-contracts.mjs eslint.config.js tests/m16-us-04-quality-gates.spec.ts",
    "lint:bot": "eslint apps/bot/src --max-warnings 0",
    "format:bot": "prettier --write apps/bot/src",
    "format:bot:check": "prettier --check apps/bot/src",
    "test:bot": "node scripts/run-bot-tests.mjs",
    "test:gift:non-ui": "vitest run tests/m22-us-06-*.spec.ts tests/m22-us-02-standalone-gift-api.spec.ts tests/m22-us-03-bot-gift-entry.spec.ts tests/m22-us-04-staff-gift-assist-api.spec.ts tests/m22-us-04-staff-gift-assist-postgres.spec.ts tests/m22-us-04-staff-gift-assist-bot.spec.ts tests/m6-us-06-api.spec.ts tests/m10-us-05-postgres.spec.ts tests/m3-us-02-api.spec.ts tests/m3-us-02-db.spec.ts tests/m3-us-06-api.spec.ts tests/m20-us-06-gift-component-protocol.spec.ts",
    "test:non-ui:harness": "NODE_ENV=test node scripts/non-ui/run-domain-gate.mjs a0",
    "test:non-ui:a1": "NODE_ENV=test node scripts/non-ui/run-domain-gate.mjs a1",
    "test:non-ui:a2": "NODE_ENV=test node scripts/non-ui/run-domain-gate.mjs a2",
    "verify:non-ui:environment": "NODE_ENV=test node scripts/non-ui/verify-environment.mjs",
    "generate:non-ui:coverage": "tsx scripts/non-ui/build-coverage-report.ts",
    "quality:bot": "npm run lint:bot && npm run format:bot:check && npm run typecheck -w @blackcat/bot && npm run build && npm run pieces -w @blackcat/bot && npm run test:bot"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.20.0",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.1.2",
    "dotenv-cli": "^7.4.4",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "@sapphire/framework": "^5.3.6",
    "discord.js": "^14.17.3",
    "fastify": "^5.2.1",
    "pg": "^8.22.0",
    "prisma": "^6.3.1",
    "zod": "^3.24.1"
  }
}
